{
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/s/:slug",
            "destination": "/api/share"
        },
        {
            "source": "/r/:code",
            "destination": "/api/share"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}