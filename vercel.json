{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/s/:slug",
            "destination": "/api/share"
        },
        {
            "source": "/r/:code",
            "destination": "/api/share"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}