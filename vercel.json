{
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/api/og",
            "destination": "/api/og"
        },
        {
            "source": "/s/:slug",
            "destination": "/api/share"
        },
        {
            "source": "/r/:code",
            "destination": "/api/share"
        },
        {
            "source": "/((?!api/|s/|r/).*)",
            "destination": "/index.html"
        }
    ]
}