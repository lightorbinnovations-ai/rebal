{
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/api/og",
            "destination": "/api/og.tsx"
        },
        {
            "source": "/s/:slug",
            "destination": "/api/share.ts"
        },
        {
            "source": "/r/:code",
            "destination": "/api/share.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}